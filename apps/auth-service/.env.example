# Auth Service Configuration Example

# Application
PORT=3001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/nestjs_demo

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES_IN=900s

# Core Service (Microservice)
# Leave commented if CORE_SERVICE is not available
CORE_SERVICE_HOST=127.0.0.1
CORE_SERVICE_PORT=4000

# Internal Auth Guard Secret
AUTH_INTERNAL_SECRET=your-internal-secret-key-here

# Keycloak (Optional - for external token exchange)
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/your-realm

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-specific-password
